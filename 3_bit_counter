module t_ff (
    input  wire clk,
    input  wire rst_n, // Active-low asynchronous reset
    input  wire t,
    output reg  q
);

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            q <= 1'b0;
        end else begin
            if (t)
                q <= ~q;
            else
                q <= q;
        end
    end

endmodule

module counter_3bit (
    input  wire       clk,
    input  wire       rst_n,
    output wire [2:0] q
);

    // Explicit wire declarations for toggle logic inputs
    wire t0;
    wire t1;
    wire t2;

    // Combinational logic connections using wires
    assign t0 = 1'b1;
    assign t1 = q[0];
    assign t2 = q[0] & q[1];

    // Instantiate 3 T Flip-Flops
    t_ff ff0 (
        .clk  (clk),
        .rst_n(rst_n),
        .t    (t0),
        .q    (q[0])
    );

    t_ff ff1 (
        .clk  (clk),
        .rst_n(rst_n),
        .t    (t1),
        .q    (q[1])
    );

    t_ff ff2 (
        .clk  (clk),
        .rst_n(rst_n),
        .t    (t2),
        .q    (q[2])
    );

endmodule

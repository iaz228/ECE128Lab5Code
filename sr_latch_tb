`timescale 1ns / 1ps

module tb_sr_latch;

    reg S;
    reg R;
    wire Q;
    wire Qbar;

    // Instantiate Unit Under Test (UUT)
    sr_latch uut (
        .S(S),
        .R(R),
        .Q(Q),
        .Qbar(Qbar)
    );

    initial begin
        $monitor("Time = %0t | S = %b, R = %b | Q = %b, Qbar = %b", $time, S, R, Q, Qbar);

        // Reset initially
        S = 0; R = 1; #10;

        // Set
        S = 1; R = 0; #10;

        // Hold
        S = 0; R = 0; #10;

        // Reset
        S = 0; R = 1; #10;

        // Invalid condition
        S = 1; R = 1; #10;

        // Return to Hold
        S = 0; R = 0; #10;

        $finish;
    end

endmodule

`timescale 1ns / 1ps

module tb_sr_flipflop;

    reg clk;
    reg rst;
    reg S;
    reg R;
    wire Q;
    wire Qbar;

    // Instantiate Unit Under Test (UUT)
    sr_flipflop uut (
        .clk(clk),
        .rst(rst),
        .S(S),
        .R(R),
        .Q(Q),
        .Qbar(Qbar)
    );

    // Clock generation (10ns period)
    always #5 clk = ~clk;

    initial begin
        clk = 0;
        rst = 1;
        S   = 0;
        R   = 0;

        $monitor("Time = %0t | rst = %b, S = %b, R = %b | Q = %b, Qbar = %b", $time, rst, S, R, Q, Qbar);

        // Release reset
        #12 rst = 0;

        // Set state at next rising clock edge
        #10 S = 1; R = 0;

        // Hold state
        #10 S = 0; R = 0;

        // Reset state
        #10 S = 0; R = 1;

        // Invalid input state
        #10 S = 1; R = 1;

        // Return to Hold state
        #10 S = 0; R = 0;

        #20 $finish;
    end

endmodule
